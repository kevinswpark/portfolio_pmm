+<!doctype html><html lang="en" data-mode="static"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>The Money Lifecycle | Kevin Park</title><meta name="description" content="Explaining how ZBD’s products work together by following money into, through, and out of a game."><meta name="color-scheme" content="dark"><meta name="theme-color" content="#08080C"><meta property="og:type" content="article"><meta property="og:title" content="The Money Lifecycle | Kevin Park"><meta property="og:description" content="Explaining how ZBD’s products work together by following money into, through, and out of a game."><meta property="og:locale" content="en_US"><meta property="og:image" content="https://kevinpark.xyz/assets/og.png"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta name="twitter:card" content="summary_large_image"><link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"><link rel="preload" href="/assets/fonts/mona-sans-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/fonts/fonts.css"><link rel="stylesheet" href="/assets/site.css"><script src="/assets/site.js" defer></script><script>window.va=window.va||function(){(window.vaq=window.vaq||[]).push(arguments)};</script><script defer src="/_vercel/insights/script.js"></script><link rel="canonical" href="https://kevinpark.xyz/work/money-lifecycle/"><meta property="og:url" content="https://kevinpark.xyz/work/money-lifecycle/"></head><body><svg class="kp-defs" width="0" height="0" aria-hidden="true" focusable="false"><defs><linearGradient id="kp-grad-h" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#3D7BFF"/><stop offset=".45" stop-color="#8B5CF6"/><stop offset=".8" stop-color="#FF3D8B"/><stop offset="1" stop-color="#FFB84D"/></linearGradient><linearGradient id="kp-grad-v" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3D7BFF"/><stop offset=".5" stop-color="#8B5CF6"/><stop offset="1" stop-color="#FF3D8B"/></linearGradient><linearGradient id="kp-grad-line" gradientUnits="userSpaceOnUse" x1="70" y1="0" x2="470" y2="0"><stop offset="0" stop-color="#3D7BFF"/><stop offset=".55" stop-color="#8B5CF6"/><stop offset="1" stop-color="#FF3D8B"/></linearGradient></defs></svg><a class="skip" href="#main">Skip to content</a><header class="nav"><nav class="nav__inner" aria-label="Main"><a class="nav__brand" href="/"><span class="logo" aria-hidden="true"><svg viewBox="0 0 64 64"><rect width="64" height="64" rx="16" fill="url(#kp-grad-v)"/><path d="M12 22C26 22 30 32 38 32M12 42C26 42 30 32 38 32" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="3.5"/><path d="M38 32H52" stroke="#fff" stroke-width="5.5" stroke-linecap="round"/></svg></span><span>Kevin Park</span></a><div class="nav__links"><a href="/#work">Work</a><a href="/#about" data-nav="about">About</a><a href="/#experience" data-nav="experience">Experience</a><div class="tools" data-tools><button class="tools__btn" type="button" aria-expanded="false" aria-controls="tools-menu">Tools<svg class="icon tools__caret" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"/></svg></button><div class="tools__panel" id="tools-menu" hidden><p class="sr-only">Tools menu</p><ul class="tools__list"><li><a class="tools__item" href="/tools/financial-planner/"><span class="tools__icon" aria-hidden="true"><svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M80,120h96a8,8,0,0,0,8-8V64a8,8,0,0,0-8-8H80a8,8,0,0,0-8,8v48A8,8,0,0,0,80,120Zm8-48h80v32H88ZM200,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V40A16,16,0,0,0,200,24Zm0,192H56V40H200ZM100,148a12,12,0,1,1-12-12A12,12,0,0,1,100,148Zm40,0a12,12,0,1,1-12-12A12,12,0,0,1,140,148Zm40,0a12,12,0,1,1-12-12A12,12,0,0,1,180,148Zm-80,40a12,12,0,1,1-12-12A12,12,0,0,1,100,188Zm40,0a12,12,0,1,1-12-12A12,12,0,0,1,140,188Zm40,0a12,12,0,1,1-12-12A12,12,0,0,1,180,188Z"/></svg></span><span class="tools__text"><span class="tools__title">Financial planner</span><span class="tools__desc">A starter money plan in about 10 minutes</span></span></a></li></ul></div></div></div><a class="btn btn--blue btn--compact" href="https://www.linkedin.com/in/kevinswpark" target="_blank" rel="noopener noreferrer"><svg class="icon icon--brand" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M216,24H40A16,16,0,0,0,24,40V216a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V40A16,16,0,0,0,216,24Zm0,192H40V40H216V216ZM96,112v64a8,8,0,0,1-16,0V112a8,8,0,0,1,16,0Zm88,28v36a8,8,0,0,1-16,0V140a20,20,0,0,0-40,0v36a8,8,0,0,1-16,0V112a8,8,0,0,1,15.79-1.78A36,36,0,0,1,184,140ZM100,84A12,12,0,1,1,88,72,12,12,0,0,1,100,84Z"/></svg><span class="btn__text">Connect on LinkedIn</span><svg class="icon icon--out" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg><span class="sr-only"> (opens in a new tab)</span></a></nav></header><main id="main" tabindex="-1"><div class="progress" aria-hidden="true"></div><header class="art-head"><div class="band band--article" aria-hidden="true"></div><div class="wrap art-head__in"><a class="crumb" href="/#work"><svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"/></svg>All work</a><h1 id="title" tabindex="-1">The Money Lifecycle</h1><p class="deck">Explaining how ZBD’s products work together by following money into, through, and out of a game.</p><ul class="facts"><li><span class="facts__k">Company</span><span class="facts__v">ZBD</span></li><li><span class="facts__k">Role</span><span class="facts__v">Senior Product Marketing Manager</span></li><li><span class="facts__k">Follows</span><a class="facts__v facts__v--grad" href="/work/money-layer/">The Money Layer for Games</a></li></ul></div></header><div class="art wrap"><aside class="rail" aria-label="On this page"><div class="rail__inner"><p class="rail__h">On this page</p><ol><li><a href="/work/money-lifecycle/#step" data-target="step">Players moved across STEP categories</a></li><li><a href="/work/money-lifecycle/#money" data-target="money">Following the money</a></li><li><a href="/work/money-lifecycle/#loop" data-target="loop">Money could stay in the game</a></li><li><a href="/work/money-lifecycle/#use" data-target="use">Used across messaging, decks, and the website</a></li><li><a href="/work/money-lifecycle/#learned" data-target="learned">What I learned</a></li></ol></div></aside><div class="flow"><section class="tldr" aria-labelledby="tldr-h"><h2 id="tldr-h">TL;DR</h2><dl><div><dt>Challenge</dt><dd>STEP grouped ZBD’s products as Shop, Transfer, Earn, and Pay, but those categories overlapped as the platform grew.</dd></div><div><dt>Approach</dt><dd>Follow how value enters a game, moves within it, and leaves it. Use that flow to explain the products together.</dd></div><div><dt>Output</dt><dd>“Money In, Money Through, Money Out,” a lifecycle model now used in the ZBD Platform messaging framework, decks, and ZBD’s public website.</dd></div></dl></section><h2 id="step">Players moved across STEP categories</h2><p class="prose">After developing <a class="inline" href="/work/money-layer/">“The Money Layer for Games”</a> to describe ZBD’s role, I needed a way to explain how the products beneath it worked together.</p><p class="prose">The existing framework was STEP: Shop, Transfer, Earn, and Pay. Its four categories were easy to remember, but a player’s experience rarely stayed inside one of them. Earn, now Embedded Rewards, made the overlap clear. A player could receive a reward, hold the value, spend it back in the game, send it to someone else, or cash out. Explaining that path meant moving across several STEP categories.</p><figure class="fig" data-title="Concept diagram"><div class="panel fig__panel fig__panel--step"><svg class="dg-step" viewBox="0 0 550 330" role="img" aria-label="STEP’s four categories, Shop, Transfer, Earn, and Pay, as side-by-side columns. One path starts in Earn and crosses into the other three."><rect class="dg-col" x="20" y="40" width="120" height="270" rx="18"/><text class="dg-label dg-label--col" x="80" y="80" text-anchor="middle">Shop</text><rect class="dg-col" x="150" y="40" width="120" height="270" rx="18"/><text class="dg-label dg-label--col" x="210" y="80" text-anchor="middle">Transfer</text><rect class="dg-col dg-col--hot" x="280" y="40" width="120" height="270" rx="18"/><text class="dg-label dg-label--col" x="340" y="80" text-anchor="middle">Earn</text><rect class="dg-col" x="410" y="40" width="120" height="270" rx="18"/><text class="dg-label dg-label--col" x="470" y="80" text-anchor="middle">Pay</text><path class="dg-flow dg-flow--open dg-flow--path" d="M340 196C312 128 150 112 92 168S150 272 214 252S372 286 470 214"/><path class="dg-head" d="M472.4 212.2L465.1 226.0L457.1 214.9z"/><circle class="dg-stopdot" cx="92" cy="168" r="6"/><circle class="dg-stopdot" cx="214" cy="252" r="6"/><circle class="dg-origin" cx="340" cy="196" r="10"/></svg><button class="zoom-btn" type="button" data-zoom aria-label="Enlarge diagram"><svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M152,112a8,8,0,0,1-8,8H120v24a8,8,0,0,1-16,0V120H80a8,8,0,0,1,0-16h24V80a8,8,0,0,1,16,0v24h24A8,8,0,0,1,152,112Zm77.66,117.66a8,8,0,0,1-11.32,0l-50.06-50.07a88.11,88.11,0,1,1,11.31-11.31l50.07,50.06A8,8,0,0,1,229.66,229.66ZM112,184a72,72,0,1,0-72-72A72.08,72.08,0,0,0,112,184Z"/></svg></button></div><figcaption><span class="pill">Concept diagram</span>Drawn for this site.</figcaption></figure><p class="prose">As ZBD’s portfolio expanded, I found myself spending more time explaining the boundaries than the products. I began looking for a model that followed the player’s experience instead.</p><h2 id="money">Following the money</h2><p class="prose">I started with two terms I knew from fintech: pay-in and payout. They described where money entered and left a system, but missed much of what ZBD could enable inside a game. Between those endpoints, players could earn, hold, spend, trade, and transfer value.</p><p class="prose">I tried calling the middle Pay Through, but “pay” made actions such as earning rewards and holding a balance sound like payments. “Money” covered those activities more naturally.</p><p class="prose">I settled on Money In, Money Through, Money Out. “Money Through” covered the activity within a game that STEP had spread across several categories.</p><figure class="fig"><div class="fig__panel fig__panel--grad fig__panel--terms"><div class="terms terms--tried"><p class="terms__k">First try</p><p class="terms__v"><span>Pay-in</span><span class="terms__sep" aria-hidden="true">/</span><span>Pay Through</span><span class="terms__sep" aria-hidden="true">/</span><span>Payout</span></p></div><div class="terms terms--final"><p class="terms__k">Final</p><p class="terms__v"><span>Money In</span><span class="sr-only">, </span><span>Money Through</span><span class="sr-only">, </span><span>Money Out</span></p></div></div><figcaption><span class="pill">Final work</span><a class="fig__cta" href="https://zbdpay.com/" target="_blank" rel="noopener noreferrer">View on zbdpay.com<svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg><span class="sr-only"> (opens in a new tab)</span></a></figcaption></figure><h2 id="loop">Money could stay in the game</h2><p class="prose">Once I drew the flow, a straight line felt incomplete. Value could enter a game, become a reward or a balance, move between players, and be spent within the game again. Some journeys ended in cash-out; others continued inside the economy.</p><figure class="fig" data-title="Concept diagram"><div class="panel fig__panel"><div class="dg-pair" role="img" aria-label="Two versions of the model. First, Money In, Money Through, and Money Out on a straight line that stops after Money Out. Second, the same three stages on a loop, so value can return to the game."><div class="dg-state"><svg viewBox="-30 0 580 360" aria-hidden="true" focusable="false"><path class="dg-arc dg-arc--line" d="M70 176H448"/><path class="dg-head dg-head--arc" d="M267.0 176.0L254.0 182.2L254.0 169.8z"/><path class="dg-head dg-head--arc" d="M457.0 176.0L444.0 182.2L444.0 169.8z"/><path class="dg-stop" d="M520 150v52"/><path class="dg-flow dg-flow--blocked" d="M478 176H508"/><circle class="dg-node" cx="70" cy="176" r="8"/><text class="dg-label dg-label--stage" x="70" y="226" text-anchor="middle">Money In</text><circle class="dg-node" cx="280" cy="176" r="8"/><text class="dg-label dg-label--stage" x="280" y="226" text-anchor="middle">Money Through</text><circle class="dg-node" cx="470" cy="176" r="8"/><text class="dg-label dg-label--stage" x="470" y="226" text-anchor="middle">Money Out</text></svg><p class="dg-state__cap"><span class="dot dot--stop"></span>A straight line ends at cash-out</p></div><div class="dg-state"><svg viewBox="-30 0 580 360" aria-hidden="true" focusable="false"><circle class="dg-ring" cx="260" cy="176" r="82"/><path class="dg-arc" d="M292.5 62.6A118 118 0 0 1 374.5 204.5"/><path class="dg-head dg-head--arc" d="M374.0 206.5L371.1 193.4L382.7 196.3z"/><path class="dg-arc" d="M342.0 260.9A118 118 0 0 1 178.0 260.9"/><path class="dg-head dg-head--arc" d="M176.6 259.5L189.4 263.5L181.1 272.1z"/><path class="dg-arc" d="M145.5 204.5A118 118 0 0 1 227.5 62.6"/><path class="dg-head dg-head--arc" d="M229.4 62.0L219.5 71.1L216.2 59.6z"/><circle class="dg-node" cx="260.0" cy="58.0" r="8"/><text class="dg-label dg-label--stage" x="260.0" y="28.0" text-anchor="middle">Money In</text><circle class="dg-node" cx="362.2" cy="235.0" r="8"/><text class="dg-label dg-label--stage" x="378.7" y="264.0" text-anchor="start">Money Through</text><circle class="dg-node" cx="157.8" cy="235.0" r="8"/><text class="dg-label dg-label--stage" x="141.3" y="264.0" text-anchor="end">Money Out</text></svg><p class="dg-state__cap"><span class="dot dot--go"></span>A lifecycle shows how value can keep moving in the game</p></div></div><button class="zoom-btn" type="button" data-zoom aria-label="Enlarge diagram"><svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M152,112a8,8,0,0,1-8,8H120v24a8,8,0,0,1-16,0V120H80a8,8,0,0,1,0-16h24V80a8,8,0,0,1,16,0v24h24A8,8,0,0,1,152,112Zm77.66,117.66a8,8,0,0,1-11.32,0l-50.06-50.07a88.11,88.11,0,1,1,11.31-11.31l50.07,50.06A8,8,0,0,1,229.66,229.66ZM112,184a72,72,0,1,0-72-72A72.08,72.08,0,0,0,112,184Z"/></svg></button></div><figcaption><span class="pill">Concept diagram</span>Drawn for this site. Stage names as published on zbdpay.com.</figcaption></figure><p class="prose">I drew the three phases as a lifecycle to show how players could keep using value inside a game. A reward could become a balance, then a purchase or a transfer to another player.</p><h2 id="use">Used across messaging, decks, and the website</h2><p class="prose">I used the lifecycle in the ZBD Platform messaging framework and sales decks, and leadership began using the same language. We could explain the product suite without assigning each product to a single stage.</p><p class="prose">The same language appears on ZBD’s homepage, the Embedded Accounts page, and the August 2026 platform launch post. I also created the platform and product videos used across the site.</p><figure class="fig"><div class="panel fig__panel fig__panel--proof"><a class="proof__host" href="https://zbdpay.com/" target="_blank" rel="noopener noreferrer"><span class="proof__dot"></span>zbdpay.com<svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg><span class="sr-only"> (opens in a new tab)</span></a><dl class="proof proof--links"><div><dt><a href="https://zbdpay.com/" target="_blank" rel="noopener noreferrer">Homepage<svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg><span class="sr-only"> (opens in a new tab)</span></a></dt><dd>Power the full lifecycle of money in games</dd></div><div><dt><a href="https://zbdpay.com/embedded-accounts" target="_blank" rel="noopener noreferrer">Embedded Accounts page<svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg><span class="sr-only"> (opens in a new tab)</span></a></dt><dd>Programmable financial infrastructure inside your game to power the full money lifecycle: money in, money through, and money out.</dd></div><div><dt><a href="https://zbdpay.com/blog/introducing-zbds-embedded-financial-infrastructure-for-games" target="_blank" rel="noopener noreferrer">Platform launch post, Aug 24, 2026<svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg><span class="sr-only"> (opens in a new tab)</span></a></dt><dd>We’re introducing our embedded financial infrastructure for games, giving studios a single platform to power the full money lifecycle.</dd></div></dl></div><figcaption><span class="pill">Published on zbdpay.com</span></figcaption></figure><h2 id="learned">What I learned</h2><p class="pull">Following a player’s money gave me a way to explain several products together. Each product could serve more than one stage, so the model still made sense as the portfolio grew.</p></div></div><section class="next wrap" aria-labelledby="next-h"><h2 class="h2 h2--sm" id="next-h">Next case study</h2><article class="tile tile--wb tile--compact" aria-labelledby="tile-wb"><div class="tile__text"><h3 id="tile-wb"><a href="/work/wirebarley/">Driving tech adoption (and how I changed customer behaviors)</a></h3><p class="tile__desc">Help Korean American customers aged 50+ complete their first transfer with WireBarley. Only about 20% of sign-ups in this group reached that point.</p><p class="result"><span class="result__chip">Korean-language TV commercial</span></p><p class="tile__impact">In the period after the commercial aired, sign-up-to-first-transfer conversion in this group rose to nearly 50%.</p><span class="tile__go" aria-hidden="true">Read the case study<svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg></span></div><div class="tile__art"><ol class="mini-story" aria-label="Commercial storyboard"><li><span class="mini-board__n">1</span><span class="mini-board__t">The familiar routine</span></li><li><span class="mini-board__n">2</span><span class="mini-board__t">A new option</span></li><li><span class="mini-board__n">3</span><span class="mini-board__t">Someone to guide him</span></li><li><span class="mini-board__n">4</span><span class="mini-board__t">Confidence through completion</span></li></ol></div></article></section><section class="closing wrap" aria-labelledby="closing"><div class="closing__card"><span class="closing__glow" aria-hidden="true"></span><h2 class="closing__h" id="closing">Let’s talk.</h2><a class="btn btn--white" href="https://www.linkedin.com/in/kevinswpark" target="_blank" rel="noopener noreferrer"><svg class="icon icon--brand" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M216,24H40A16,16,0,0,0,24,40V216a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V40A16,16,0,0,0,216,24Zm0,192H40V40H216V216ZM96,112v64a8,8,0,0,1-16,0V112a8,8,0,0,1,16,0Zm88,28v36a8,8,0,0,1-16,0V140a20,20,0,0,0-40,0v36a8,8,0,0,1-16,0V112a8,8,0,0,1,15.79-1.78A36,36,0,0,1,184,140ZM100,84A12,12,0,1,1,88,72,12,12,0,0,1,100,84Z"/></svg><span class="btn__text">Connect on LinkedIn</span><svg class="icon icon--out" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg><span class="sr-only"> (opens in a new tab)</span></a></div></section></main><footer class="foot wrap"><div class="foot__row"><span class="logo" aria-hidden="true"><svg viewBox="0 0 64 64"><rect width="64" height="64" rx="16" fill="url(#kp-grad-v)"/><path d="M12 22C26 22 30 32 38 32M12 42C26 42 30 32 38 32" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="3.5"/><path d="M38 32H52" stroke="#fff" stroke-width="5.5" stroke-linecap="round"/></svg></span><span>© 2026 Kevin Park</span><a href="https://www.linkedin.com/in/kevinswpark" target="_blank" rel="noopener noreferrer">linkedin.com/in/kevinswpark<span class="sr-only"> (opens in a new tab)</span></a></div></footer><dialog class="zoom" id="zoom" aria-labelledby="zoom-title"><div class="zoom__bar"><p class="zoom__title" id="zoom-title"></p><button class="zoom__close" type="button" aria-label="Close"><svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"/></svg></button></div><div class="zoom__body"></div></dialog></body></html>
