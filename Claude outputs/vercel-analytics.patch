e" x1="70" y1="0" x2="470" y2="0"><stop offset="0" stop-color="#3D7BFF"/><stop offset=".55" stop-color="#8B5CF6"/><stop offset="1" stop-color="#FF3D8B"/></linearGradient></defs></svg><a class="skip" href="#main">Skip to content</a><header class="nav"><nav class="nav__inner" aria-label="Main"><a class="nav__brand" href="/"><span class="logo" aria-hidden="true"><svg viewBox="0 0 64 64"><rect width="64" height="64" rx="16" fill="url(#kp-grad-v)"/><path d="M12 22C26 22 30 32 38 32M12 42C26 42 30 32 38 32" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="3.5"/><path d="M38 32H52" stroke="#fff" stroke-width="5.5" stroke-linecap="round"/></svg></span><span>Kevin Park</span></a><div class="nav__links"><a href="/#work">Work</a><a href="/#about" data-nav="about">About</a><a href="/#experience" data-nav="experience">Experience</a><div class="tools" data-tools><button class="tools__btn" type="button" aria-expanded="false" aria-controls="tools-menu">Tools<svg class="icon tools__caret" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"/></svg></button><div class="tools__panel" id="tools-menu" hidden><p class="sr-only">Tools menu</p><ul class="tools__list"><li><a class="tools__item" href="/tools/financial-planner/"><span class="tools__icon" aria-hidden="true"><svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M80,120h96a8,8,0,0,0,8-8V64a8,8,0,0,0-8-8H80a8,8,0,0,0-8,8v48A8,8,0,0,0,80,120Zm8-48h80v32H88ZM200,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V40A16,16,0,0,0,200,24Zm0,192H56V40H200ZM100,148a12,12,0,1,1-12-12A12,12,0,0,1,100,148Zm40,0a12,12,0,1,1-12-12A12,12,0,0,1,140,148Zm40,0a12,12,0,1,1-12-12A12,12,0,0,1,180,148Zm-80,40a12,12,0,1,1-12-12A12,12,0,0,1,100,188Zm40,0a12,12,0,1,1-12-12A12,12,0,0,1,140,188Zm40,0a12,12,0,1,1-12-12A12,12,0,0,1,180,188Z"/></svg></span><span class="tools__text"><span class="tools__title">Financial planner</span><span class="tools__desc">A starter money plan in about 10 minutes</span></span></a></li></ul></div></div></div><a class="btn btn--blue btn--compact" href="https://www.linkedin.com/in/kevinswpark" target="_blank" rel="noopener noreferrer"><svg class="icon icon--brand" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M216,24H40A16,16,0,0,0,24,40V216a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V40A16,16,0,0,0,216,24Zm0,192H40V40H216V216ZM96,112v64a8,8,0,0,1-16,0V112a8,8,0,0,1,16,0Zm88,28v36a8,8,0,0,1-16,0V140a20,20,0,0,0-40,0v36a8,8,0,0,1-16,0V112a8,8,0,0,1,15.79-1.78A36,36,0,0,1,184,140ZM100,84A12,12,0,1,1,88,72,12,12,0,0,1,100,84Z"/></svg><span class="btn__text">Connect on LinkedIn</span><svg class="icon icon--out" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg><span class="sr-only"> (opens in a new tab)</span></a></nav></header><main id="main" tabindex="-1"><div class="progress" aria-hidden="true"></div><header class="art-head"><div class="band band--article" aria-hidden="true"></div><div class="wrap art-head__in"><a class="crumb" href="/#work"><svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"/></svg>All work</a><h1 id="title" tabindex="-1">Driving tech adoption (and how I changed customer behaviors)</h1><p class="deck">Helping Korean American customers feel confident making their first digital money transfer.</p><ul class="facts"><li><span class="facts__k">Company</span><span class="facts__v">WireBarley</span></li><li><span class="facts__k">Role</span><span class="facts__v">Product Marketing Manager, first US marketing hire</span></li></ul></div></header><div class="art wrap"><aside class="rail" aria-label="On this page"><div class="rail__inner"><p class="rail__h">On this page</p><ol><li><a href="/work/wirebarley/#audience" data-target="audience">The most profitable audience had the lowest conversion rate</a></li><li><a href="/work/wirebarley/#support" data-target="support">Qualitative data revealed the need for a “hand-holding” experience</a></li><li><a href="/work/wirebarley/#commercial" data-target="commercial">What customers aged 50+ needed was reassurance</a></li><li><a href="/work/wirebarley/#results" data-target="results">Results</a></li><li><a href="/work/wirebarley/#learned" data-target="learned">What I learned</a></li></ol></div></aside><div class="flow"><section class="tldr" aria-labelledby="tldr-h"><h2 id="tldr-h">TL;DR</h2><dl><div><dt>Challenge</dt><dd>Help Korean American customers aged 50+ complete their first transfer with WireBarley. Only about 20% of sign-ups in this group reached that point.</dd></div><div><dt>Approach</dt><dd>Use customer support call logs to understand where people needed reassurance, then show that support in a Korean-language TV commercial.</dd></div><div><dt>Result</dt><dd>In the period after the commercial aired, sign-up-to-first-transfer conversion in this group rose to nearly 50%.</dd></div></dl></section><h2 id="audience">The most profitable audience had the lowest conversion rate</h2><p class="prose">As WireBarley’s first US marketing hire, I worked on bringing its digital remittance service to Korean American customers and adjacent Asian American communities. The service let people send money abroad without visiting a bank.</p><p class="prose">COVID lockdowns had accelerated the move toward contactless services, creating an opportunity for digital remittance. Earning people’s trust remained a challenge, especially when asking them to change how they handled money.</p><p class="prose">Internal data showed that customers aged 50+ were our most profitable audience, with average transfer amounts roughly $250 above the overall average. Yet many stopped early in identity verification, and only about 20% went on to make their first transfer. I wanted to understand what was holding them back.</p><h2 id="support">Qualitative data revealed the need for a “hand-holding” experience</h2><p class="prose">Before developing the commercial’s storyboard, I reviewed customer support call logs in Zendesk. Customers often mentioned that their sons or daughters would normally help them with this kind of task.</p><p class="prose">The conversations showed that these customers could take a photo of their ID, enter their information, and follow the verification steps. They needed someone they trusted to guide them while they learned an unfamiliar process.</p><p class="prose">WireBarley already had live customer support agents in the US who spoke Korean and English, alongside support in Thai, Mandarin, Vietnamese, Nepali, and other languages. I wanted the commercial to show how a Korean-speaking agent could help someone feel comfortable making their first transfer.</p><h2 id="commercial">What customers aged 50+ needed was reassurance</h2><p class="prose">I developed a TV commercial for local Korean-language channels serving Koreatowns across the US. TV was a familiar medium for this audience and complemented our existing newspaper and other mass-media advertising.</p><p class="prose">I wanted viewers to recognize their own situation and see how someone like them could complete a transfer with support. The commercial followed four steps:</p><figure class="fig"><div class="panel fig__panel fig__panel--story"><ol class="board"><li class="board__step"><span class="board__n">1</span><p class="board__t">The familiar routine</p><p class="board__d">An older man prepares to visit a bank to send money to his wife in Korea.</p><span class="board__arrow" aria-hidden="true"><svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg></span></li><li class="board__step"><span class="board__n">2</span><p class="board__t">A new option</p><p class="board__d">His daughter introduces WireBarley as a fee-free, more economical alternative. She has to leave for work and offers to help him when she returns.</p><span class="board__arrow" aria-hidden="true"><svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg></span></li><li class="board__step"><span class="board__n">3</span><p class="board__t">Someone to guide him</p><p class="board__d">He decides to try it himself and calls customer support. A Korean-speaking agent walks him through the transfer with the warmth of a helpful neighbor.</p><span class="board__arrow" aria-hidden="true"><svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg></span></li><li class="board__step board__step--end"><span class="board__n">4</span><p class="board__t">Confidence through completion</p><p class="board__d">He completes the transfer and realizes it was easier than he expected. The commercial closes with a happy family scene.</p></li></ol></div><figcaption><span class="pill">Commercial storyboard</span>From a familiar routine to a confident first transfer.</figcaption></figure><figure class="fig"><div class="fig__panel fig__panel--video"><iframe src="https://www.youtube-nocookie.com/embed/KDBksoj_wu8?rel=0" title="WireBarley TV commercial" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><figcaption><span class="pill">TV commercial</span><a class="fig__cta" href="https://www.youtube.com/watch?v=KDBksoj_wu8" target="_blank" rel="noopener noreferrer">Watch the commercial on YouTube<svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg><span class="sr-only"> (opens in a new tab)</span></a></figcaption></figure><h2 id="results">Results</h2><ul class="results"><li class="results__item results__item--lead"><span class="results__k">First-transfer conversion among customers aged 50+</span><span class="results__v"><mark class="fig">About 20%</mark> → <mark class="fig">nearly 50%</mark> after the commercial aired.</span></li><li class="results__item"><span class="results__k">Broader business milestone</span><span class="results__v">WireBarley led traditional Korean American banks in remittance volume to Korea during Chuseok, Korean Thanksgiving.</span></li><li class="results__item"><span class="results__k">Media coverage</span><span class="results__v">Featured on SBS America, representing the Korean American segment.</span></li></ul><figure class="fig"><div class="fig__panel fig__panel--photo"><img src="/assets/sbs-evening-news.jpg" width="1400" height="721" alt="SBS Evening News segment with a lower-third title naming Kevin Park as a WireBarley manager, over close-up footage of US hundred-dollar bills." loading="lazy" decoding="async"></div><figcaption><span class="pill">Media coverage</span>Screenshot from SBS Evening News. The on-screen title reads “Kevin Park, WireBarley manager.”</figcaption></figure><h3>Other results at WireBarley</h3><ul class="role__bullets"><li>Scaled the Nepal corridor to <mark class="fig">$5M</mark> in peak weekly remittance volume, with <mark class="fig">300%</mark> year-over-year transaction growth.</li><li>Led bilingual campaigns that drove <mark class="fig">$40M</mark> in holiday remittance volume. WireBarley reached the leading market position among Korean Americans by 2023.</li><li>Delivered <mark class="fig">300%</mark> year-over-year US growth while operating within <mark class="fig">40%</mark> of the previous year’s North American marketing budget.</li><li>Built executive dashboards (Tableau, R) to guide product, retention, and expansion decisions.</li></ul><h2 id="learned">What I learned</h2><p class="pull">Finding the hesitation that prevents someone from acting can reveal a simple way to improve conversion. In fintech, showing customers that you understand their situation and have built an experience around their needs can give them a reason to trust you with their money.</p></div></div><section class="next wrap" aria-labelledby="next-h"><h2 class="h2 h2--sm" id="next-h">Next case study</h2><article class="tile tile--ml tile--compact" aria-labelledby="tile-ml"><div class="tile__text"><h3 id="tile-ml"><a href="/work/money-layer/">Using a visual metaphor to explain ZBD’s role</a></h3><p class="tile__desc">ZBD offered financial infrastructure for games, but we lacked a consistent way to explain its role. I developed “The Money Layer for Games” to give the company a shared description.</p><p class="result"><span class="result__chip">The Money Layer for Games</span></p><p class="tile__impact">ZBD uses the line on its public website.</p><span class="tile__go" aria-hidden="true">Read the case study<svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg></span></div><div class="tile__art panel"><div class="dg-pair" role="img" aria-label="Two states of one diagram. First, a wall stops value moving from a game economy to financial systems. Second, the wall opens into a layer marked ZBD that value can cross."><div class="dg-state"><svg viewBox="0 0 560 350" aria-hidden="true" focusable="false"><text class="dg-label" x="30" y="44">Game economy</text><text class="dg-label" x="530" y="44" text-anchor="end">Financial systems</text><g class="dg-tokens"><circle cx="78" cy="118" r="11"/><circle cx="118" cy="186" r="11"/><circle cx="70" cy="252" r="11"/><rect x="150" y="106" width="20" height="20" rx="3" transform="rotate(45 160 116)"/><rect x="160" y="232" width="20" height="20" rx="3" transform="rotate(45 170 242)"/></g><g class="dg-accounts"><rect x="404" y="98" width="70" height="42" rx="8"/><rect x="404" y="166" width="70" height="42" rx="8"/><rect x="404" y="234" width="70" height="42" rx="8"/><path d="M404 111h70M404 179h70M404 247h70"/></g><rect class="dg-wall" x="264" y="70" width="32" height="228" rx="10"/><path class="dg-flow dg-flow--blocked" d="M92 118H250"/><path class="dg-stop" d="M255 108v20"/><path class="dg-flow dg-flow--blocked" d="M132 186H250"/><path class="dg-stop" d="M255 176v20"/><path class="dg-flow dg-flow--blocked" d="M84 252H250"/><path class="dg-stop" d="M255 242v20"/></svg><p class="dg-state__cap"><span class="dot dot--stop"></span>A boundary that blocks passage</p></div><div class="dg-state"><svg viewBox="0 0 560 350" aria-hidden="true" focusable="false"><text class="dg-label" x="30" y="44">Game economy</text><text class="dg-label" x="530" y="44" text-anchor="end">Financial systems</text><g class="dg-tokens"><circle cx="78" cy="118" r="11"/><circle cx="118" cy="186" r="11"/><circle cx="70" cy="252" r="11"/><rect x="150" y="106" width="20" height="20" rx="3" transform="rotate(45 160 116)"/><rect x="160" y="232" width="20" height="20" rx="3" transform="rotate(45 170 242)"/></g><g class="dg-accounts"><rect x="404" y="98" width="70" height="42" rx="8"/><rect x="404" y="166" width="70" height="42" rx="8"/><rect x="404" y="234" width="70" height="42" rx="8"/><path d="M404 111h70M404 179h70M404 247h70"/></g><g class="dg-layer"><rect x="264" y="70" width="32" height="30" rx="8"/><rect x="264" y="138" width="32" height="30" rx="8"/><rect x="264" y="206" width="32" height="30" rx="8"/><rect x="264" y="268" width="32" height="30" rx="8"/></g><text class="dg-label dg-label--layer" x="280" y="336" text-anchor="middle">ZBD</text><path class="dg-flow dg-flow--open" d="M92 118C200 118 230 119 280 119S360 118 394 118"/><path class="dg-head" d="M400.0 118.0l-8.0 -5.0v9.9z"/><path class="dg-flow dg-flow--open" d="M132 186C200 186 230 187 280 187S360 186 394 186"/><path class="dg-head" d="M400.0 186.0l-8.0 -5.0v9.9z"/><path class="dg-flow dg-flow--open" d="M84 252C200 252 230 252 280 252S360 252 394 252"/><path class="dg-head" d="M400.0 252.0l-8.0 -5.0v9.9z"/></svg><p class="dg-state__cap"><span class="dot dot--go"></span>A layer that lets value cross</p></div></div></div></article></section><section class="closing wrap" aria-labelledby="closing"><div class="closing__card"><span class="closing__glow" aria-hidden="true"></span><h2 class="closing__h" id="closing">Let’s talk.</h2><a class="btn btn--white" href="https://www.linkedin.com/in/kevinswpark" target="_blank" rel="noopener noreferrer"><svg class="icon icon--brand" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M216,24H40A16,16,0,0,0,24,40V216a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V40A16,16,0,0,0,216,24Zm0,192H40V40H216V216ZM96,112v64a8,8,0,0,1-16,0V112a8,8,0,0,1,16,0Zm88,28v36a8,8,0,0,1-16,0V140a20,20,0,0,0-40,0v36a8,8,0,0,1-16,0V112a8,8,0,0,1,15.79-1.78A36,36,0,0,1,184,140ZM100,84A12,12,0,1,1,88,72,12,12,0,0,1,100,84Z"/></svg><span class="btn__text">Connect on LinkedIn</span><svg class="icon icon--out" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/></svg><span class="sr-only"> (opens in a new tab)</span></a></div></section></main><footer class="foot wrap"><div class="foot__row"><span class="logo" aria-hidden="true"><svg viewBox="0 0 64 64"><rect width="64" height="64" rx="16" fill="url(#kp-grad-v)"/><path d="M12 22C26 22 30 32 38 32M12 42C26 42 30 32 38 32" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="3.5"/><path d="M38 32H52" stroke="#fff" stroke-width="5.5" stroke-linecap="round"/></svg></span><span>© 2026 Kevin Park</span><a href="https://www.linkedin.com/in/kevinswpark" target="_blank" rel="noopener noreferrer">linkedin.com/in/kevinswpark<span class="sr-only"> (opens in a new tab)</span></a></div></footer><dialog class="zoom" id="zoom" aria-labelledby="zoom-title"><div class="zoom__bar"><p class="zoom__title" id="zoom-title"></p><button class="zoom__close" type="button" aria-label="Close"><svg class="icon " viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"/></svg></button></div><div class="zoom__body"></div></dialog></body></html>
